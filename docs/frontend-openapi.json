    "/api/analysis/{analysis_id}": {
      "get": {
        "tags": [
          "Contracts"
        ],
        "summary": "Read Analysis",
        "operationId": "read_analysis_api_analysis__analysis_id__get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Analysis"
                    },
                    {
                      "$ref": "#/components/schemas/AnalysisFailure"
                    }
                  ],
                  "title": "Response Read Analysis Api Analysis  Analysis Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/analysis": {
      "get": {
        "tags": [
          "Contracts",
          "Demo"
        ],
        "summary": "Read Demo",
        "operationId": "read_demo_api_demo_analysis_get",
