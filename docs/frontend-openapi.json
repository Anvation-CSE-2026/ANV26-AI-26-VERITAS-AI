    "/api/embeddings/test": {
      "post": {
        "tags": [
          "Embeddings"
        ],
        "summary": "Test Embedding",
        "operationId": "test_embedding_api_embeddings_test_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingTestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/upload": {
      "post": {
        "tags": [
          "Contracts"
        ],
        "summary": "Upload Contract",
        "operationId": "upload_contract_api_contracts_upload_post",
