APP_NAME=VERITAS AI
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120
GEMINI_TIMEOUT_SECONDS=90
# Optional absolute path; default is data/contracts/veritas.sqlite3
# STORAGE_PATH=C:/path/to/veritas.sqlite3
MAX_UPLOAD_BYTES=10485760
MAX_CONTRACT_PAGES=30
MAX_CONTRACT_CHARS=60000
MAX_CONTRACT_CLAUSES=100
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=1

# Authentication & Security (JWT)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REQUIRED=true
ALLOW_LEGACY_UNAUTHENTICATED_ACCESS=false

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourTestWebhookSecretHere
RAZORPAY_STANDARD_PLAN_ID=plan_standard_monthly_inr199
RAZORPAY_PRO_PLAN_ID=plan_pro_monthly_inr299
